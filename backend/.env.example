DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_ALLOWED_HOSTS=your-backend-domain.onrender.com,your-api-domain.com
APP_ENVIRONMENT=production
DEPLOY_PROVIDER=render
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-dashboard-domain.com
CSRF_TRUSTED_ORIGINS=https://your-backend-domain.onrender.com,https://your-dashboard-domain.com
DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_SSL_REQUIRE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
RASPBERRY_PI_BASE_URL=http://192.168.18.181:5001
DEVICE_INGEST_TOKEN=change-this-device-token
PUBLIC_APP_URL=https://your-parent-app-domain.com
ALLOW_INSECURE_DEVICE_INGEST=False
ALLOW_PUBLIC_DASHBOARD_RESET=False
ALLOW_PUBLIC_ADMIN_DASHBOARD=False
NOTIFICATION_COOLDOWN_SECONDS=300
